#!/usr/bin/python3

import argparse
import sys
import os
import numpy as np
import lpips
from scipy.linalg import sqrtm

import torchvision.transforms as transforms
from torchvision.utils import save_image
from torch.utils.data import DataLoader
from torch.autograd import Variable
import torch
from torchvision import models
from torchmetrics import StructuralSimilarityIndexMeasure as SSIM

# 修改
from models import Generator
from datasets import ImageDataset

# ================== 参数解析 (Argument Parsing) ==================
parser = argparse.ArgumentParser()
parser.add_argument('--batchSize', type=int, default=1, help='size of the batches')
parser.add_argument('--dataroot', type=str, default='data/monet2photo/', help='root directory of the dataset')
parser.add_argument('--input_nc', type=int, default=3, help='number of channels of input data')
parser.add_argument('--output_nc', type=int, default=3, help='number of channels of output data')
parser.add_argument('--size', type=int, default=256, help='size of the data (squared assumed)')
parser.add_argument('--cuda', action='store_true', help='use GPU computation')
parser.add_argument('--n_cpu', type=int, default=8, help='number of cpu threads to use during batch generation')
parser.add_argument('--generator_A2B', type=str, default='implementations/dualgan/saved_models/monet2photo/G_AB_200.pth', help='A2B generator checkpoint file')
parser.add_argument('--generator_B2A', type=str, default='implementations/dualgan/saved_models/monet2photo/G_BA_200.pth', help='B2A generator checkpoint file')
opt = parser.parse_args()
print(opt)


def test():
    global inception_transform, avg_lpips_A, avg_lpips_B
    if torch.cuda.is_available() and not opt.cuda:
        print("WARNING: You have a CUDA device, so you should probably run with --cuda")

    ###### Definition of variables ######
    # Networks
    netG_A2B = Generator()
    netG_B2A = Generator()

    if opt.cuda:
        netG_A2B.cuda()
        netG_B2A.cuda()

    # Load state dicts
    netG_A2B.load_state_dict(torch.load(opt.generator_A2B))  # 加载A→B生成器权重
    netG_B2A.load_state_dict(torch.load(opt.generator_B2A))  # 加载B→A生成器权重

    # Set model's test mode
    netG_A2B.eval()
    netG_B2A.eval()

    # Inputs & targets memory allocation
    Tensor = torch.cuda.FloatTensor if opt.cuda else torch.Tensor
    input_A = Tensor(opt.batchSize, opt.input_nc, opt.size, opt.size)
    input_B = Tensor(opt.batchSize, opt.output_nc, opt.size, opt.size)

    # Dataset loader
    transforms_ = [
        transforms.ToTensor(),
        transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))]
    dataloader = DataLoader(
        ImageDataset(opt.dataroot, transforms_=transforms_, mode='test'),
        batch_size=opt.batchSize,
        shuffle=False,
        num_workers=opt.n_cpu
    )
    ###################################

    ###### Testing######

    # Create output dirs if they don't exist
    if not os.path.exists('output/monet2photo/A'):
        os.makedirs('output/monet2photo/A')
    if not os.path.exists('output/monet2photo/B'):
        os.makedirs('output/monet2photo/B')

    # ================== 初始化指标计算变量 ==================
    # 初始化 PSNR 和 SSIM 的累加器
    total_psnr_A = 0.0
    total_ssim_A = 0.0
    total_psnr_B = 0.0
    total_ssim_B = 0.0
    count = 0

    # 初始化 FID 的特征列表
    real_A_features = []
    fake_A_features = []
    real_B_features = []
    fake_B_features = []

    # 初始化 LPIPS 的累加器
    total_lpips_A = 0.0
    total_lpips_B = 0.0
    lpips_model = None
    try:
        # 使用 AlexNet 作为特征提取器（更快）
        lpips_model = lpips.LPIPS(net='alex')
        lpips_model.eval()
        # if opt.cuda:
        #     lpips_model = lpips_model.cuda()

        lpips_model = lpips_model.cpu()
        print("LPIPS model loaded")
    except Exception as e:
        print(f"Warning: LPIPS model not available. Error: {e}")
        lpips_model = None

    # ================== 初始化 Inception V3 用于 FID 计算 ==================
    try:
        # 加载预训练的 Inception V3 模型
        inception = models.inception_v3(pretrained=True, transform_input=False)
        inception.eval()
        if opt.cuda:
            inception = inception.cuda()

        # Inception 的预处理
        inception_transform = transforms.Compose([
            transforms.Resize(299),
            transforms.CenterCrop(299),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
        ])
        print("Inception V3 model loaded for FID calculation")
    except Exception as e:
        print(f"Warning: FID calculation not available. Error: {e}")
        inception = None

    # ================== 初始化 SSIM ==================
    # 创建SSIM指标实例
    ssim_metric_A = SSIM(data_range=1.0)
    ssim_metric_B = SSIM(data_range=1.0)

    for i, batch in enumerate(dataloader):
        # Set model input
        real_A = Variable(input_A.copy_(batch['A']))
        real_B = Variable(input_B.copy_(batch['B']))

        # Generate output
        fake_B = 0.5 * (netG_A2B(real_A).data + 1.0)  # 将[-1,1]范围的生成结果映射到[0,1]
        fake_A = 0.5 * (netG_B2A(real_B).data + 1.0)

        fake_A = fake_A.cpu()
        fake_B = fake_B.cpu()

        # Save image files
        save_image(fake_A, 'output/monet2photo/A/%04d.png' % (i + 1))
        save_image(fake_B, 'output/monet2photo/B/%04d.png' % (i + 1))

        # ================== 计算 PSNR 和 SSIM ==================
        # 将图像转换为 [0,1] 范围（用于 PSNR 和 SSIM）
        real_A_01 = (batch['A'] + 1) / 2
        real_B_01 = (batch['B'] + 1) / 2

        # 计算 A 域的 PSNR 和 SSIM
        psnr_A = 20 * torch.log10(1.0 / torch.sqrt(torch.mean((real_A_01 - fake_A) ** 2)))
        # 计算 A 域的 SSIM
        ssim_metric_A.update(fake_A, real_A_01)
        ssim_A = ssim_metric_A.compute()

        # 计算 B 域的 PSNR 和 SSIM
        psnr_B = 20 * torch.log10(1.0 / torch.sqrt(torch.mean((real_B_01 - fake_B) ** 2)))
        # 计算 B 域的 SSIM
        ssim_metric_B.update(fake_B, real_B_01)
        ssim_B = ssim_metric_B.compute()

        # 累加指标
        total_psnr_A += psnr_A.item()
        total_ssim_A += ssim_A.item()
        total_psnr_B += psnr_B.item()
        total_ssim_B += ssim_B.item()
        count += 1

        # ================== 计算 LPIPS ==================
        if lpips_model is not None:
            # LPIPS 需要 [-1, 1] 范围的图像
            # real_A_01 和 fake_A 都是 [0, 1] 范围，需要转换为 [-1, 1]
            real_A_lpips = (batch['A'] + 1) / 2  # [0, 1]
            fake_A_lpips = fake_A  # [0, 1]

            # 转换为 [-1, 1] 范围
            real_A_lpips_norm = real_A_lpips * 2 - 1  # [0,1] -> [-1,1]
            fake_A_lpips_norm = fake_A_lpips * 2 - 1  # [0,1] -> [-1,1]

            # 计算 A 域的 LPIPS (real_A vs fake_A)
            with torch.no_grad():
                lpips_A_val = lpips_model(real_A_lpips_norm, fake_A_lpips_norm)
            total_lpips_A += lpips_A_val.item()

            # 对 B 域做同样处理
            real_B_lpips = (batch['B'] + 1) / 2  # [0, 1]
            fake_B_lpips = fake_B  # [0, 1]

            # 转换为 [-1, 1] 范围
            real_B_lpips_norm = real_B_lpips * 2 - 1  # [0,1] -> [-1,1]
            fake_B_lpips_norm = fake_B_lpips * 2 - 1  # [0,1] -> [-1,1]

            # 计算 B 域的 LPIPS (real_B vs fake_B)
            with torch.no_grad():
                lpips_B_val = lpips_model(real_B_lpips_norm, fake_B_lpips_norm)
            total_lpips_B += lpips_B_val.item()

        # ================== 收集 FID 特征 ==================
        if inception is not None:
            # 处理 A 域真实图像
            real_A_tensor = (batch['A'] + 1) / 2  # 转换为 [0,1]
            real_A_tensor = inception_transform(real_A_tensor)
            if opt.cuda:
                real_A_tensor = real_A_tensor.cuda()
            with torch.no_grad():
                real_A_feat = inception(real_A_tensor)
            real_A_features.append(real_A_feat.cpu().detach())

            # 处理 A 域生成图像
            fake_A_tensor = inception_transform(fake_A)
            if opt.cuda:
                fake_A_tensor = fake_A_tensor.cuda()
            with torch.no_grad():
                fake_A_feat = inception(fake_A_tensor)
            fake_A_features.append(fake_A_feat.cpu().detach())

            # 处理 B 域真实图像
            real_B_tensor = (batch['B'] + 1) / 2  # 转换为 [0,1]
            real_B_tensor = inception_transform(real_B_tensor)
            if opt.cuda:
                real_B_tensor = real_B_tensor.cuda()
            with torch.no_grad():
                real_B_feat = inception(real_B_tensor)
            real_B_features.append(real_B_feat.cpu().detach())

            # 处理 B 域生成图像
            fake_B_tensor = inception_transform(fake_B)
            if opt.cuda:
                fake_B_tensor = fake_B_tensor.cuda()
            with torch.no_grad():
                fake_B_feat = inception(fake_B_tensor)
            fake_B_features.append(fake_B_feat.cpu().detach())

        sys.stdout.write('\rGenerated images %04d of %04d' % (i + 1, len(dataloader)))

    sys.stdout.write('\n')
    ###################################

    # ================== 计算平均指标 ==================
    avg_psnr_A = total_psnr_A / count
    avg_ssim_A = total_ssim_A / count
    avg_psnr_B = total_psnr_B / count
    avg_ssim_B = total_ssim_B / count

    print(f"\nAverage PSNR (A domain): {avg_psnr_A:.4f} dB")
    print(f"Average SSIM (A domain): {avg_ssim_A:.4f}")
    print(f"Average PSNR (B domain): {avg_psnr_B:.4f} dB")
    print(f"Average SSIM (B domain): {avg_ssim_B:.4f}")

    # 计算平均 LPIPS
    if lpips_model is not None:
        avg_lpips_A = total_lpips_A / count
        avg_lpips_B = total_lpips_B / count
        print(f"\nAverage LPIPS (A domain): {avg_lpips_A:.4f}")
        print(f"Average LPIPS (A domain): {avg_lpips_B:.4f}")

    # ================== 计算 FID (在测试集上) ==================
    if inception is not None:
        # 将特征列表转换为张量
        real_A_features = torch.cat(real_A_features, dim=0)
        fake_A_features = torch.cat(fake_A_features, dim=0)
        real_B_features = torch.cat(real_B_features, dim=0)
        fake_B_features = torch.cat(fake_B_features, dim=0)

        print(f"Real A features shape: {real_A_features.shape}")
        print(f"Fake A features shape: {fake_A_features.shape}")

        fid_A = calculate_fid(real_A_features, fake_A_features)
        fid_B = calculate_fid(real_B_features, fake_B_features)

        print(f"\nFID (A domain): {fid_A:.4f}")
        print(f"FID (B domain): {fid_B:.4f}")
    else:
        print("\nFID calculation skipped (Inception V3 not available)")

    # ================== 保存指标结果 ==================
    with open('output/monet2photo/saved_results/metrics.txt', 'w') as f:
        f.write(f"Average PSNR (A domain): {avg_psnr_A:.4f} dB\n")
        f.write(f"Average SSIM (A domain): {avg_ssim_A:.4f}\n")
        f.write(f"Average PSNR (B domain): {avg_psnr_B:.4f} dB\n")
        f.write(f"Average SSIM (B domain): {avg_ssim_B:.4f}\n")
        if lpips_model is not None:
            f.write(f"Average LPIPS (A domain): {avg_lpips_A:.4f}\n")
            f.write(f"Average LPIPS (B domain): {avg_lpips_B:.4f}\n")
        else:
            f.write("LPIPS calculation skipped (lpips library not available)\n")
        if inception is not None:
            f.write(f"FID (A domain): {fid_A:.4f}\n")
            f.write(f"FID (B domain): {fid_B:.4f}\n")
        else:
            f.write("FID calculation skipped\n")

    print("\nMetrics saved to output/metrics.txt")


# 计算 FID
def calculate_fid(real_features, fake_features):
    # 计算均值
    mu_real = torch.mean(real_features, dim=0)
    mu_fake = torch.mean(fake_features, dim=0)

    # 转置矩阵
    real_features_transposed = real_features.transpose(0, 1)  # [features_dim, batch_size]
    fake_features_transposed = fake_features.transpose(0, 1)  # [features_dim, batch_size]

    # 计算协方差
    sigma_real = torch.cov(real_features_transposed)
    sigma_fake = torch.cov(fake_features_transposed)

    # 计算 FID
    diff = mu_real - mu_fake
    diff_norm = torch.norm(diff) ** 2

    # 使用 scipy.linalg.sqrtm 替代 torch.sqrtm
    cov_product = sigma_real @ sigma_fake
    # 转换为 numpy 计算矩阵平方根
    cov_product_np = cov_product.cpu().numpy()
    cov_mean_np = sqrtm(cov_product_np)
    # 检查是否是复数矩阵（有时特征值为负，sqrtm 会返回复数）
    if np.iscomplexobj(cov_mean_np):
        cov_mean_np = np.real(cov_mean_np)
    cov_mean = torch.from_numpy(cov_mean_np).float().to(real_features.device)

    fid = diff_norm + torch.trace(sigma_real + sigma_fake - 2 * cov_mean)
    return fid.item()


if __name__ == '__main__':
    test()
